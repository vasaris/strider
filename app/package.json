{
  "name": "@brodyazhnik/app",
  "version": "0.1.0",
  "description": "Brodyazhnik PWA: Next.js App Router shell over the engine and orchestrator workspace packages. Private prototype.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@brodyazhnik/engine": "*",
    "@brodyazhnik/orchestrator": "*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
