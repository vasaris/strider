{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brodyazhnik.local/schemas/ui_labels.schema.json",
  "title": "Pack UI labels (names for ids without a structured pack name). Sidecar, not a content[] table.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "verified",
    "locale",
    "terminology",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "const": "kv.ui_labels" },
    "type": { "const": "ui_labels" },
    "verified": { "type": "boolean" },
    "locale": { "const": "ru" },
    "terminology": { "const": "pandora_box" },
    "notes": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["group", "id", "name_ru", "source_card", "evidence"],
            "properties": {
              "group": { "enum": ["region", "outcome", "condition", "tracker"] },
              "id": { "type": "string", "minLength": 1 },
              "name_ru": { "type": "string", "minLength": 1 },
              "source_card": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
